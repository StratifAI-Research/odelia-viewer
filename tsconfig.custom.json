{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@ohif/*": ["./custom/types/ohif-any.d.ts"]
    }
  },
  "include": [
    "custom/types/ohif-any.d.ts",
    "custom/extension/*/src/**/*",
    "custom/extension/*/ui/**/*",
    "custom/mode/*/src/**/*"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.js",
    "**/__mocks__/**",
    "**/test-utils/**"
  ]
}
