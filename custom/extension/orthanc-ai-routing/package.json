{
  "name": "orthanc-ai-routing",
  "version": "0.0.1",
  "private": true,
  "description": "Extension to send studies to AI endpoint via Orthanc routing plugin. Developed for ODELIA project",
  "author": "Bulat Maksudov",
  "license": "MIT",
  "main": "src/index.tsx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StratifAI-Research/odelia-viewer.git",
    "directory": "custom/extension/orthanc-ai-routing"
  },
  "keywords": [
    "ohif-extension"
  ],
  "module": "src/index.tsx",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test:unit": "jest --config jest.config.js",
    "test:unit:watch": "jest --config jest.config.js --watchAll",
    "test:unit:ci": "jest --config jest.config.js --ci --runInBand --collectCoverage --coverageProvider=v8 --passWithNoTests"
  },
  "peerDependencies": {
    "@ohif/core": "workspace:*",
    "@ohif/extension-cornerstone": "workspace:*",
    "@ohif/extension-default": "workspace:*",
    "@ohif/i18n": "workspace:*",
    "@ohif/ui-next": "workspace:*",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "12.3.1",
    "react-router": "6.30.3",
    "react-router-dom": "6.30.3"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7"
  }
}
