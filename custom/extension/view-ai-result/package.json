    "@ohif/i18n": "^1.0.0",
    "prop-types": "^15.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^12.2.2",
    "react-router": "^6.23.1",
    "react-router-dom": "^6.23.1"
  },
  "dependencies": {
    "@babel/runtime": "^7.20.13",
    "dompurify": "^3.4.11",
    "marked": "^4.3.0",
    "react-resize-detector": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.24.7",
    "@babel/plugin-proposal-class-properties": "^7.16.7",
