# Defaults for the viewer repository's development/reference Compose stack.
# Copy to .env to override them. Deployment configuration is maintained in
# https://github.com/StratifAI-Research/odelia-viewer-platform

# Empty preserves the container runtime's default published-port binding.
# Use a plain IP such as 127.0.0.1 or ::1, without a trailing colon.
BIND_HOST=

# Comma-separated destination hostnames for routing/WADO retrieval.
# Empty disables the allowlist. Include every required PACS/router/subscriber host.
ROUTER_HOST_ALLOWLIST=

# Comma-separated viewer origins, including scheme and port, for HTTP CORS
# and the optional WebSocket origin check (e.g. http://localhost:8081).
CHAT_ALLOWED_ORIGINS=

# Disabled by default. For production, set to 1 and explicitly configure the
# allowed viewer origins above. Origin checks do not authenticate clients.
CHAT_WEBSOCKET_ORIGIN_CHECK=0

# Development-only default credentials. Use deployment-specific credentials
# in production; these inputs do not rotate passwords of existing users.
GF_SECURITY_ADMIN_PASSWORD=odelia
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=password
